# Path to NOOP's SQLite database. Run `python -m app.probe --find` to locate it.
# This file is opened READ-ONLY (mode=ro + PRAGMA query_only). Nothing writes to it.
NOOP_DB_PATH=

# Server. 0.0.0.0 lets your phone reach the dashboard over the LAN.
# There is NO authentication — use 127.0.0.1 if you only want local access.
HOST=0.0.0.0
PORT=8765

# IANA timezone used to decide what "today" means and for display.
# NOTE: NOOP buckets days by UTC (SCHEMA_NOTES.md 1.4); this does not re-bucket.
DISPLAY_TZ=UTC

# Optional: pin table/column names the resolver gets wrong. See README.
# SCHEMA_MAP_PATH=./schema_map.json

# This app's own database: habits, journal, notes and workouts. Deliberately a
# separate file from NOOP's, so a NOOP update can never clobber your data.
# Back this one up — it is the only copy of anything you type.
APP_DB_PATH=./data/dashboard.sqlite3

# Phase 4: the strap's BLE address. Leave empty until you have run
#   python tools/bench_strap.py --scan
# With no address the dashboard still schedules alarms and persists them; it
# just reports honestly that it could not put them on the strap.
# macOS shows a system UUID here rather than a MAC address — that is normal.
STRAP_ADDRESS=
